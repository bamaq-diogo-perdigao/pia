# Configurações específicas do podcast; integrações ficam nos plugins compartilhados.
TZ=America/Sao_Paulo
PODCAST_CONFIG=config/config.json
POLL_INTERVAL_SECONDS=600
DRIVE_PROCESS=true
LOCAL_DRIVE_FOLDER=data/local-drive
DOWNLOAD_DIR=data/download
WORK_DIR=data/work
PUBLICAR_DIRETO=false


OWNER_EMAIL=

TRANSCRIPTS_FILE=transcripts.html
SKIP_CLOSED=true
FEED_CACHE_DIR=data/cache/feeds
FEED_FORCE_REBUILD=false
